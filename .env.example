# Core
APP_ENV=development
CRON_SECRET=replace-with-long-random-value

# OpenAI (optional until AI agents are enabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# YouTube / Google
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TRENDS_PROVIDER=mock

# Social Blade Business API — historical public channel statistics
SOCIALBLADE_CLIENT_ID=
SOCIALBLADE_TOKEN=
# default = up to 30 days; extended = up to 1 year; archive = up to 3 years
SOCIALBLADE_HISTORY=default
SOCIALBLADE_MAX_CHANNELS_PER_SYNC=12

# Relational + vector memory
DATABASE_URL=
PGVECTOR_ENABLED=false

# Temporal knowledge graph
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Future signal providers
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEWS_API_KEY=
SOCIAL_LISTENING_API_URL=
SOCIAL_LISTENING_API_KEY=
